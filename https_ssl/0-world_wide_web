#!/usr/bin/env bash
# Displays information about subdomains for a given domain
# shellcheck disable=SC2086

function audit_subdomain() {
    local domain=$1
    local sub=$2
    local result
    result=$(dig "${sub}.${domain}" | grep -A1 'ANSWER SECTION:' | tail -n 1)
    local r_type
    r_type=$(echo "$result" | awk '{print $4}')
    local dest
    dest=$(echo "$result" | awk '{print $5}')
    echo "The subdomain ${sub} is a ${r_type} record and points to ${dest}"
}

if [ "$#" -eq 1 ]; then
    audit_subdomain "$1" "www"
    audit_subdomain "$1" "lb-01"
    audit_subdomain "$1" "web-01"
    audit_subdomain "$1" "web-02"
elif [ "$#" -eq 2 ]; then
    audit_subdomain "$1" "$2"
fi
